# ========================================================
# RAZE — FUTURISTIC AI AGENT PLATFORM ENVIRONMENT CONFIG
# ========================================================

# Server Port
PORT=3001
NODE_ENV=development

# Optional External AI Providers (If empty, RAZE operates in 100% offline Deterministic Demo Mode)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional External Live Search Provider
SEARCH_API_PROVIDER=academic_aggregator
SEARCH_API_KEY=

# Local Persistent Database
DATABASE_PATH=./data/openguard.sqlite

# Security & Sandbox Limits
MAX_EXECUTION_TIMEOUT_MS=30000
RATE_LIMIT_MAX_REQUESTS_PER_MIN=120
